// Privacy Launcher as a system app.
//
// Drop this folder into an AOSP or LineageOS tree at
// packages/apps/PrivacyLauncher/ with the release APK beside it, then add
// PrivacyLauncher to the device's PRODUCT_PACKAGES.
android_app_import {
    name: "PrivacyLauncher",
    apk: "PrivacyLauncher.apk",

    // Privileged, so it lands in /system/priv-app. This is what makes it
    // the home screen with no question asked: the launcher's manifest gives
    // its home screen a priority of 1, and Android only honours a priority
    // above 0 for privileged apps in the system image. In /system/app the
    // priority would be set back to 0 and the first boot would ask the user
    // to choose between this and Android's own launcher. Checked in the
    // emulator by tools/os-preview.sh; see docs/os.md.
    privileged: true,

    // PRESIGNED keeps the launcher's own signature rather than re-signing
    // with the ROM's platform key. That matters for updates: an APK signed
    // with the same key can be installed over this one, so the launcher can
    // be updated without rebuilding the whole system image.
    certificate: "PRESIGNED",

    dex_preopt: {
        // Ahead-of-time compile it into the image. This is the system-app
        // equivalent of the baseline profile: the home screen is the one
        // app that must not be slow on first boot.
        enabled: true,
    },
}
